# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch / Model Weights & Binary Checkpoints
*.pth
*.hef
*.engine
*.bin
/weights/
/yolov8n.pt
runs/detect/runs/benchmarks/
runs/detect/runs/yolov8n_seraphim/weights/

# Whitelist release weights & progress
!runs/yolov8n_seraphim/weights/last.pt
!runs/yolov8n_seraphim/weights/best.pt
